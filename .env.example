# Frontend: for development you can use the same Google key for Android Maps + backend APIs,
# but it must use Application restriction = None while the backend is also using it.
# For production, split this into a dedicated Android Maps key and a separate backend key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-single-google-key

# Firebase Web config used by DoorDrop and DoorDrive. Keep real values in .env.local,
# EAS environment variables, or deployment secrets. Do not commit real keys.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=efootball-app-9d175.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=efootball-app-9d175
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=efootball-app-9d175.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=729242246964
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Production APKs must point to a hosted HTTPS backend that every user can reach.
# Firebase Functions endpoint:
EXPO_PUBLIC_API_BASE_URL=https://us-central1-efootball-app-9d175.cloudfunctions.net/api

# Server-only Mongike key for DoorDrive access payments. Put the real value in
# backend/.env or deployment secrets, never in EXPO_PUBLIC_* variables.
# MONGIKE_API_KEY=your-mongike-api-key

# Local Android emulator development only:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Local physical device development only, on the same Wi-Fi as your laptop:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.17:4000
