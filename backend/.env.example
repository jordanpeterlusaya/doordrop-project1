# Backend HTTP server.
# Cloud hosts normally inject PORT automatically. Use BACKEND_PORT for local development.
# PORT=4000
BACKEND_PORT=4000

# Comma-separated list of allowed origins for browser clients.
# Use * for mobile-only local testing, then lock this down in production.
CORS_ALLOWED_ORIGINS=*

# Required for local Firebase Admin reads/writes used by admin-only backend endpoints.
# In deployed Firebase Functions this is injected automatically.
DOORDROP_FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: point to a Firebase Admin service account JSON file, ignored by git.
# DOORDROP_FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Option B: paste JSON as one line instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option C: Render/hosted env variables. Paste PRIVATE KEY exactly as one line with \n escapes.
# Render required Firebase Admin env:
# DOORDROP_FIREBASE_PROJECT_ID=efootball-app-9d175
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@efootball-app-9d175.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINES\n-----END PRIVATE KEY-----\n
# GOOGLE_CLOUD_PROJECT=efootball-app-9d175
# GCLOUD_PROJECT=efootball-app-9d175

# Development: you can reuse the same general Google key as the app if its application restriction is set to None.
# Production later: use a dedicated server key here.
GOOGLE_SERVER_API_KEY=your-google-key-for-places-and-routes

# Firebase Functions will read backend/.env during deploy. Keep real values in backend/.env,
# not in this example file.

# Optional overrides if you ever split them later.
# GOOGLE_PLACES_API_KEY=your-server-places-api-new-key
# GOOGLE_ROUTES_API_KEY=your-server-routes-key

# Temporary debug webhook for backend Places and Routes instrumentation.
DEBUG_WEBHOOK_URL=https://bin.webhookrelay.com/v1/webhooks/76750585-a212-4e22-a9a3-985422e032ac

# Mongike live mobile money collections. Keep the real key only in backend/.env
# or hosted deployment secrets. Do not expose it through EXPO_PUBLIC_* values.
MONGIKE_API_KEY=your-mongike-api-key
# Optional override. Defaults to https://mongike.com/api/v1
# MONGIKE_API_BASE_URL=https://mongike.com/api/v1
# Public HTTPS endpoint Mongike should call after payment completion.
# If omitted, backend tries PUBLIC_API_BASE_URL / BACKEND_PUBLIC_URL / EXPO_PUBLIC_API_BASE_URL.
MONGIKE_WEBHOOK_URL=https://us-central1-efootball-app-9d175.cloudfunctions.net/api/driver-payments/webhook/mongike
DRIVER_DAILY_ACCESS_FEE_TZS=3000
DRIVER_ACCESS_DURATION_HOURS=24
DRIVER_PAYMENT_ACTIVE_NETWORK=mpesa
DRIVER_PAYMENT_RECIPIENT_PHONE=0750355402

# DoorDrop fares are fixed in backend/config.js.
# pikipiki parcel: base 800, rate 450/km, time buffer 80/km, min 1000
# toyo: base 5000, rate 1800, min 5000, size extras small 0, half 600, full 1200, overload 2400
# kirikuu: base 5200, rate 2200, min 8000, size extras small 0, half 800, full 1600, overload 3000

# Test commands
# curl -sS "http://localhost:4000/places/autocomplete?input=Kariakoo&sessionToken=diag-session&latitude=-6.7924&longitude=39.2083&limit=3"
# curl -sS "http://localhost:4000/places/details?placeId=YOUR_PLACE_ID&sessionToken=diag-session"
# curl -sS -X POST "http://localhost:4000/routes/estimate" -H "Content-Type: application/json" -d "{\"origin\":{\"latitude\":-6.7924,\"longitude\":39.2083},\"destination\":{\"latitude\":-6.8172,\"longitude\":39.2897},\"vehicleType\":\"toyo\",\"cargoSize\":\"half\"}"
# curl -sS -X POST "http://localhost:4000/pricing/estimate" -H "Content-Type: application/json" -d "{\"vehicleType\":\"toyo\",\"distanceMeters\":9978,\"cargoSize\":\"half\"}"
