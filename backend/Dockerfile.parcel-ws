# Public parcel-offer WebSocket (HAUL ↔ carriers). Deploy to Cloud Run.
FROM node:22-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY *.js ./

ENV NODE_ENV=production
ENV PARCEL_OFFER_WS_PORT=8080
ENV PORT=8080
ENV DOORDROP_FIREBASE_PROJECT_ID=efootball-app-9d175

EXPOSE 8080
CMD ["node", "parcel-offer-ws.js"]
