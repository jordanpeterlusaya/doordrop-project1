# Copy to ../.env.local or doordropdrive/.env before building a standalone APK.
# Required for Android map rendering (app.config.js fails the build if this is missing).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-android-maps-sdk-key

# Firebase (DoorDrive auth + Firestore). Use the same web app config as DoorDrop.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=efootball-app-9d175.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=efootball-app-9d175
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=efootball-app-9d175.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=729242246964
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Production API — baked into release APK via EAS env or app.config.js extra.
EXPO_PUBLIC_API_BASE_URL=https://us-central1-efootball-app-9d175.cloudfunctions.net/api

# Cargo instant-verify WebSocket — production Cloud Run (worldwide wss):
# EXPO_PUBLIC_CARGO_OFFER_WS_URL=wss://haul-cargo-offer-ws-XXXX.us-central1.run.app
# EXPO_PUBLIC_PARCEL_OFFER_WS_URL=wss://haul-parcel-offer-ws-XXXX.us-central1.run.app
# Redeploy: bash ../backend/scripts/deploy-offer-ws.sh
# Local LAN only (start: npm --prefix ../backend run cargo-ws):
# EXPO_PUBLIC_CARGO_OFFER_WS_URL=ws://192.168.1.17:4010
