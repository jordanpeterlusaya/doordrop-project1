{
  "name": "doordrive",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client --localhost --port 8082",
    "start:dev": "expo start --dev-client --localhost --port 8082 --clear",
    "prebuild:android": "EXPO_NO_WEB=1 expo prebuild --platform android --clean",
    "prepare:apk": "bash scripts/prepare-standalone-apk.sh",
    "build:apk:local": "cd android && ./gradlew assembleRelease",
    "build:apk:eas": "bash scripts/build-standalone-apk-eas.sh",
    "android": "expo run:android --port 8082",
    "android:dev": "expo run:android --port 8082 --variant debug",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.12.0",
    "incoming-alert": "file:./modules/incoming-alert",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "expo-dev-client": "~6.0.21",
    "typescript": "~5.9.2"
  }
}
