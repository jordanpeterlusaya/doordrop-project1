{
  "expo": {
    "name": "DoorDrive",
    "slug": "doordrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "scheme": "doordrive",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.doordrive.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundColor": "#16A34A"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#16A34A"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "owner": "jordanpeter",
    "extra": {
      "eas": {
        "projectId": "53e9314f-0ec8-4256-ae9c-9160f2c3aa2f"
      }
    }
  }
}
